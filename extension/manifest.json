{
  "manifest_version": 3,
  "name": "career-ops companion",
  "version": "0.1.0",
  "description": "Match score, one-click save and safe autofill for job postings, backed by your local career-ops app. Never submits an application.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "career-ops"
  },
  "options_page": "src/options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
